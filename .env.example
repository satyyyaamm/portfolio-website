# Web3Forms — free tier: https://web3forms.com (sign up with your email, copy Access Key)
VITE_WEB3FORMS_ACCESS_KEY=

# Public site URL (no trailing slash) — used for canonical, Open Graph, and JSON-LD.
# Production: https://buildwithsatyam.in — optional override on Vercel (e.g. https://www.buildwithsatyam.in).
# If unset, build falls back to https://buildwithsatyam.in
VITE_SITE_URL=
