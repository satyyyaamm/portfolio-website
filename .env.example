# Web3Forms — free tier: https://web3forms.com (sign up with your email, copy Access Key)
VITE_WEB3FORMS_ACCESS_KEY=

# Public site URL (no trailing slash) — used for canonical, Open Graph, and JSON-LD.
# Production: https://www.buildwithsatyam.in (apex redirects to www on Vercel)
# If unset, build falls back to https://www.buildwithsatyam.in
VITE_SITE_URL=

# Google Analytics 4 — measurement ID must match Admin → Data streams
# Stream URL in GA4 should be https://www.buildwithsatyam.in (not apex-only)
VITE_GA_MEASUREMENT_ID=G-RGB7SXQS6T
